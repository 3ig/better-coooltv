<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 7.0 predates Let's Encrypt's ISRG Root X1 (added in 7.1.1), and GitHub serves release
  downloads from a Let's Encrypt host, so bundle that root next to the system ones.
  Cleartext stays allowed as before (some stream/logo URLs are plain http).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
        </trust-anchors>
    </base-config>
</network-security-config>
